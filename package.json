{
  "name": "feuer",
  "version": "0.1.0",
  "description": "A browser multiplayer real-time strategy game prototype",
  "private": true,
  "author": {
    "email": "jannik@feuer.dev",
    "name": "Jannik Feuerhahn",
    "url": "https://feuer.dev"
  },
  "license": "ISC",
  "workspaces": [
    "client",
    "server",
    "shared"
